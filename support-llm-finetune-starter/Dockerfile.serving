FROM vllm/vllm-openai:latest

ENV MODEL_PATH=/models/support-llm-merged
ENV SERVED_MODEL_NAME=support-llm-finetuned

EXPOSE 8000

ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server", \
            "--model", "/models/support-llm-merged", \
            "--served-model-name", "support-llm-finetuned", \
            "--host", "0.0.0.0", \
            "--port", "8000"]
